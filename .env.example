# Cloudinary Credentials (required for cloud upload & QR code generation)
# Sign up for free at https://cloudinary.com and copy your Dashboard keys here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# digiCamControl Settings (Canon DSLR / Windows default setup)
# Path to digiCamControl's remote CLI utility
DIGICAM_REMOTE_CMD=C:\Program Files (x86)\digiCamControl\CameraControlRemoteCmd.exe

# Capture command sent to digiCamControl ("capturenoaf" skips autofocus; use "capture" to enable AF)
DIGICAM_CAPTURE_CMD=capturenoaf

# Temporary capture path (MUST NOT contain spaces due to digiCamControl CLI parsing bug,
# and MUST be in a writable folder—do NOT use C:\ root due to Windows UAC restrictions).
# Leave commented out to default to <UserHome>\temp_capture.jpg (only set explicitly if your
# Windows username contains spaces, e.g. D:\photobooth_temp\temp_capture.jpg).
# TEMP_CAPTURE_PATH=D:\photobooth_temp\temp_capture.jpg
